{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar-nacional.invalid/schemas/radar-package.schema.json",
  "title": "Radar Nacional package",
  "description": "Contrato v1 de snapshot, delta e workset. O aplicativo não importa worksets.",
  "type": "object",
  "required": [
    "manifest",
    "payload"
  ],
  "properties": {
    "manifest": {
      "type": "object",
      "required": [
        "app_id",
        "schema_version",
        "package_type",
        "previous_version",
        "data_version",
        "created_at",
        "checksum_algorithm",
        "checksum_sha256"
      ],
      "properties": {
        "app_id": {
          "const": "radar-nacional"
        },
        "schema_version": {
          "const": 1
        },
        "package_type": {
          "enum": [
            "snapshot",
            "delta",
            "workset"
          ]
        },
        "previous_version": {
          "type": "integer",
          "minimum": 0
        },
        "data_version": {
          "type": "integer",
          "minimum": 0
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "checksum_algorithm": {
          "const": "SHA-256"
        },
        "checksum_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/snapshotPayload"
        },
        {
          "$ref": "#/$defs/deltaPayload"
        },
        {
          "$ref": "#/$defs/worksetPayload"
        }
      ]
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "required": [
        "id",
        "type",
        "title",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "adherence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10
        },
        "axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "factual_status": {
          "enum": [
            "confirmed",
            "pending_review",
            "disputed"
          ]
        },
        "horizon": {
          "enum": [
            "short",
            "medium",
            "long",
            "curto_prazo",
            "medio_prazo",
            "longo_prazo"
          ]
        },
        "impact": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "media_opportunity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "urgency": {
          "$ref": "#/$defs/urgency"
        },
        "is_archived": {
          "type": "boolean"
        },
        "is_demo": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "axis": {
      "type": "object",
      "required": [
        "axis_id",
        "incidence",
        "score",
        "rationale",
        "evidence"
      ],
      "properties": {
        "axis_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "incidence": {
          "enum": [
            "direct",
            "indirect",
            "mention"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "rationale": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "monitoring": {
      "type": "object",
      "required": [
        "id",
        "source_checkpoints",
        "record_states",
        "coverage_gaps",
        "pending_review"
      ],
      "properties": {
        "id": {
          "const": "state"
        },
        "source_checkpoints": {
          "type": "array"
        },
        "record_states": {
          "type": "array"
        },
        "coverage_gaps": {
          "type": "array"
        },
        "pending_review": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "snapshotPayload": {
      "type": "object",
      "required": [
        "records",
        "people",
        "institutions",
        "events",
        "sources",
        "monitoring"
      ],
      "properties": {
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "institutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entity"
          }
        },
        "monitoring": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/monitoring"
          }
        }
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "required": [
        "op",
        "table",
        "id",
        "data"
      ],
      "properties": {
        "op": {
          "const": "upsert"
        },
        "table": {
          "enum": [
            "records",
            "people",
            "institutions",
            "events",
            "sources",
            "monitoring"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": true
    },
    "deltaPayload": {
      "type": "object",
      "required": [
        "operations"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      },
      "additionalProperties": true
    },
    "worksetPayload": {
      "type": "object",
      "required": [
        "monitoring_state",
        "records_to_review",
        "record_index",
        "people_index",
        "institutions_index",
        "source_index",
        "batch"
      ],
      "properties": {
        "monitoring_state": {
          "type": "object"
        },
        "records_to_review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "record_index": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "people_index": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "institutions_index": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_index": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "batch": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "urgency": {
      "type": "object",
      "properties": {
        "temporal": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "moral": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "institutional": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "media": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "record_id",
        "date",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "record_id": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
